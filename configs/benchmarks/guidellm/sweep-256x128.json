{
  "metadata": {
    "labels": {
      "scenario": "sweep-256x128"
    }
  },
  "spec": {
    "profile": {
      "kind": "sweep"
    },
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 30
      },
      {
        "kind": "max_errors",
        "count": 3
      },
      {
        "kind": "over_saturation"
      }
    ],
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 256,
        "output_tokens": 128
      }
    ],
    "seed": {
      "kind": "static",
      "value": 42
    },
    "metrics": {
      "kind": "generative",
      "sample_size": 10
    }
  }
}
